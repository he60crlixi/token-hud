{
  "name": "token-hud",
  "version": "0.2.0",
  "private": true,
  "description": "Live tok/s and token usage for your coding agent, in a separate always-visible window. One agent-agnostic core, small adapters for OpenCode, Claude Code, Codex and Gemini CLI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./adapters/opencode": "./adapters/opencode.js"
  },
  "bin": {
    "token-hud": "bin/token-hud.mjs"
  },
  "scripts": {
    "start": "node bin/token-hud.mjs",
    "check": "node scripts/selfcheck.mjs && node scripts/adapter.test.mjs && node scripts/install.test.mjs",
    "install-agents": "node scripts/install.mjs"
  },
  "files": [
    "core.js",
    "index.js",
    "page.html",
    "bin",
    "adapters",
    "scripts",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "tokens",
    "tok/s",
    "hud",
    "token-usage",
    "opencode",
    "opencode-plugin",
    "claude-code",
    "codex",
    "gemini-cli",
    "llm",
    "cli",
    "developer-tools"
  ],
  "dependencies": {
    "@opencode/plugin": "2.0.16"
  }
}
